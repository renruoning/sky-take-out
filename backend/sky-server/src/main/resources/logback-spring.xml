<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="DB_URL" source="spring.datasource.druid.url"/>
    <springProperty name="DB_USERNAME" source="spring.datasource.druid.username"/>
    <springProperty name="DB_PASSWORD" source="spring.datasource.druid.password"/>
    <springProperty name="DB_DRIVER" source="spring.datasource.druid.driver-class-name"/>

    <!-- 只把 WARN 及以上级别写入数据库，避免 mapper debug 级别的SQL日志把 sys_log 表刷爆 -->
    <appender name="DB" class="com.sky.log.DbLogAppender">
        <url>${DB_URL}</url>
        <username>${DB_USERNAME}</username>
        <password>${DB_PASSWORD}</password>
        <driverClassName>${DB_DRIVER}</driverClassName>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- 异步包一层，写库操作放到独立线程，不阻塞业务请求线程；队列满时优先丢弃低优先级日志而不是阻塞 -->
    <appender name="ASYNC_DB" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="DB"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_DB"/>
    </root>
</configuration>
